<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What raw multicast sockets need on an iPhone (iOS 14 and later):
     build_probe.sh device signs with it when IOS_MULTICAST=1. Apple grants
     it to a team on request; a profile without it refuses to sign. -->
<plist version="1.0"><dict>
  <key>com.apple.developer.networking.multicast</key><true/>
</dict></plist>
